{
  "manifest_version": 3,
  "name": "Series Tracker",
  "version": "2.0.0",
  "description": "Busca series en las webs que configures (providers), guarda tu lista, la sincroniza con Supabase y avisa cuando sale el siguiente episodio.",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "extension/background.js", "type": "module" },
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "Series Tracker",
    "default_icon": { "16": "extension/icons/icon16.png", "48": "extension/icons/icon48.png", "128": "extension/icons/icon128.png" }
  },
  "options_page": "extension/options.html",
  "icons": { "16": "extension/icons/icon16.png", "48": "extension/icons/icon48.png", "128": "extension/icons/icon128.png" }
}
