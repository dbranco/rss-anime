# Copia este archivo a .env y rellena los valores. .env nunca se sube al repo (ver .gitignore).

# Settings → API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Settings → API → Secret key (antes "service_role"). ¡Nunca en la extensión ni versionado!
SUPABASE_SERVICE_KEY=

# --- Opcionales (ver cron/generate-feed.mjs) ---
# FEED_OUT_DIR=./feeds       # además de subir a Supabase Storage, escribe los .xml aquí
# NO_UPLOAD=1                # no subir a Supabase Storage (solo con FEED_OUT_DIR tiene sentido)
# SHOW_URL=1                 # imprime la URL secreta del feed (solo para pruebas en local)
# MAX_AHEAD=5                # episodios a mirar por delante del último visto
